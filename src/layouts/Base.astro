---
import "../styles/global.css";
import { getCollection } from "astro:content";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "logic77lhl · 十三个尝试",
  description = "AI 来了之后，一个人七十来天做了十三个尝试：背单词、电影年鉴、数据抓取。做得到，和值得做，不是一回事。",
  image = "/og.png",
  noindex = false,
} = Astro.props;

// 写作区还没文章时，导航里不出现空入口
const posts = await getCollection("writing", ({ data }) => !data.draft);

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="theme-color" content="#fbf9f5" />
    <meta name="color-scheme" content="light dark" />

    <!-- 在首次绘制前决定主题，避免闪白 / 闪黑 -->
    <script is:inline>
      (() => {
        let theme = "light";
        try {
          if (localStorage.getItem("theme") === "dark") theme = "dark";
        } catch {}
        document.documentElement.dataset.theme = theme;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#0b0d10" : "#fbf9f5");
      })();
    </script>
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="mark">L</span>
          <span>
            logic77lhl
            <small>BUILD · SHIP · NOTE</small>
          </span>
        </a>
        <nav class="nav">
          <a href="/#projects">项目</a>
          {posts.length > 0 && <a href="/writing/">写作</a>}
          <a href="/#about">关于</a>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深色 / 浅色">
            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
            </svg>
          </button>
          <a class="ghost" href="https://github.com/logic77lhl" target="_blank" rel="noreferrer">
            GitHub ↗
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-foot">
      <div class="wrap">
        <span>© 2026 logic77lhl · 用 Astro 拼的，放在 GitHub Pages 上</span>
        <span>
          <a href="https://github.com/logic77lhl" target="_blank" rel="noreferrer">GitHub</a>
          <span> · </span>
          <a href="/sitemap-index.xml">Sitemap</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById("theme-toggle");
        const meta = document.querySelector('meta[name="theme-color"]');
        if (!btn) return;

        btn.addEventListener("click", () => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          if (meta) meta.setAttribute("content", next === "dark" ? "#0b0d10" : "#fbf9f5");
          try {
            localStorage.setItem("theme", next);
          } catch {}
        });
      })();
    </script>
  </body>
</html>
